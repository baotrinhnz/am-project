# venue_secrets.env  — secret DÙNG CHUNG cho mọi venue
# ---------------------------------------------------------------------------
# Copy file này thành `venue_secrets.env` rồi điền key thật.
# File `venue_secrets.env` ĐÃ được .gitignore — KHÔNG commit lên git.
# Nếu không có file này, provision_venue_pi.sh sẽ tự hỏi từng key khi chạy.

# Supabase (chung mọi Pi)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY

# ACRCloud (chung mọi venue — lấy từ console.acrcloud.com)
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=YOUR_ACR_ACCESS_KEY
ACRCLOUD_ACCESS_SECRET=YOUR_ACR_ACCESS_SECRET
